# .gitignore

# ignore build artifacts
build/

# ignore node_modules
node_modules/

# ignore pyc files
*.pyc

# ignore coverage reports
coverage.xml
coverage.html

# ignore venv
venv/

# ignore IDE files
.idea/
.vscode/

# ignore docker containers
docker-compose.log
docker-compose.log*

# ignore local config files
config.json
config.yaml

# ignore local db files
*.db
*.sqlite3

# ignore local cache
cache/

# ignore local logs
logs/

# ignore local temp files
tmp/